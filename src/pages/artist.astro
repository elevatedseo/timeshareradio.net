---
import Layout from '../layouts/Layout.astro';
const artists = [{ name: 'Test Artist', genre: 'Independent / Alternative', initials: 'TA' },{ name: 'Test Artist 2', genre: 'Electronic / New Wave', initials: 'T2' },{ name: 'Test Artist 3', genre: 'Soul / R&B', initials: 'T3' }];
---
<Layout title="Artist Directory Demo | Time Share Radio" description="See the artist directory created by the Time Share Radio WordPress plugin.">
  <section class="page-hero artist-hero"><span class="section-num">PLUGIN DEMO / ARTIST DIRECTORY</span><h1>EVERY ARTIST.<br /><em>A HOME.</em></h1><p>The Time Share Radio plugin turns artist entries into a browsable directory and dedicated bio pages—without assembling every profile by hand.</p></section>
  <section class="demo-bar"><span>LIVE FEATURE PREVIEW</span><p>This page demonstrates the artist-directory experience generated by the plugin.</p><a href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG">Buy the plugin ↗</a></section>
  <section class="artist-directory"><div class="directory-head"><h2>Artist Bios</h2><span>03 ARTISTS</span></div><div class="artist-grid">
    {artists.map((artist, i) => <article class="artist-card"><a href="#" aria-label={`Preview ${artist.name} bio`}><div class={`artist-image artist-image-${i + 1}`}><strong>{artist.initials}</strong><span>VIEW BIO ↗</span></div><small>{artist.genre}</small><h2>{artist.name}</h2><p>If you are looking to get your music played on the radio, we’ve got you covered.</p></a></article>)}
  </div></section>
</Layout>
