---
import Layout from '../layouts/Layout.astro';
const artists = [{ name: 'Busta Rhymes', genre: 'Hip-Hop / Rap', initials: 'BR', image: '/images/artists/busta-rhymes.jpg', href: '/artist/busta-rhymes/' },{ name: 'Artist Profile 2', genre: 'Electronic / New Wave', initials: '02' },{ name: 'Artist Profile 3', genre: 'Soul / R&B', initials: '03' }];
---
<Layout title="Artist Directory Demo | Time Share Radio" description="See the artist directory created by the Time Share Radio WordPress plugin.">
  <section class="page-hero artist-hero"><span class="section-num">PLUGIN DEMO / ARTIST DIRECTORY</span><h1>EVERY ARTIST.<br /><em>A HOME.</em></h1><p>The Time Share Radio plugin turns artist entries into a browsable directory and dedicated bio pages—without assembling every profile by hand.</p></section>
  <section class="demo-bar"><span>LIVE FEATURE PREVIEW</span><p>This page demonstrates the artist-directory experience generated by the plugin.</p><a href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG">Buy the plugin ↗</a></section>
  <section class="artist-directory"><div class="directory-head"><h2>Artist Bios</h2><span>03 ARTISTS</span></div><div class="artist-grid">
    {artists.map((artist, i) => <article class="artist-card"><a href={artist.href || '#'} aria-label={`Preview ${artist.name} bio`}><div class={`artist-image artist-image-${i + 1}`} style={artist.image ? `background-image:url(${artist.image})` : undefined}><strong>{artist.image ? '' : artist.initials}</strong><span>VIEW BIO ↗</span></div><small>{artist.genre}</small><h2>{artist.name}</h2><p>{i === 0 ? 'Legendary hip-hop artist known for his fast-paced flow, high-energy delivery, and iconic sound.' : 'A complete artist bio and music profile generated by the plugin.'}</p></a></article>)}
  </div></section>
</Layout>
