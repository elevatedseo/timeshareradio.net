---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    name: 'Song Review',
    price: 25,
    desc: 'Professional written review of your track with actionable feedback on production, arrangement, and radio readiness.',
    features: ['Written review within 7 days', 'Production feedback', 'Radio-readiness score'],
  },
  {
    name: 'Priority Review',
    price: 100,
    desc: 'Jump the line. Your track reviewed first with detailed scoring and a direct path to airplay consideration.',
    features: ['48-hour turnaround', 'Detailed scoring rubric', 'Airplay recommendation', 'Featured in review queue'],
    popular: true,
  },
  {
    name: 'Artist Interview',
    price: 250,
    desc: 'A full on-air interview segment. Tell your story, promote your music, and connect with real listeners.',
    features: ['15-min on-air interview', 'Audio replay + analytics', 'Social media promo', 'Artist profile feature'],
  },
  {
    name: 'Featured Artist',
    price: 500,
    desc: 'The full spotlight. Homepage feature, heavy rotation consideration, interview, and social push.',
    features: ['Everything in Interview', 'Homepage spotlight (30 days)', 'Heavy rotation consideration', 'Social media campaign', 'Analytics dashboard'],
  },
  {
    name: 'Airplay Campaign',
    price: 750,
    priceNote: '$500 – $1,000 based on market',
    desc: 'A targeted spin campaign across our station network. Real spins, real listeners, real momentum.',
    features: ['Guaranteed spin package', 'Multi-station reach', 'Spin reports + analytics', 'Campaign manager'],
  },
];

const airtime = [
  {
    name: '30-Minute AirRental',
    price: '100',
    priceNote: 'starting at — non-commercial',
    desc: 'Your own 30-minute show. Your music, your voice, your audience.',
    features: ['30-min broadcast slot', 'Streaming replay', 'Listener analytics'],
  },
  {
    name: '60-Minute AirRental',
    price: '200',
    priceNote: 'starting at — non-commercial',
    desc: 'A full hour. Go deeper — interviews, guest mixes, full creative control.',
    features: ['60-min broadcast slot', 'Streaming replay', 'Listener analytics', 'Priority scheduling'],
  },
  {
    name: 'Monthly Residency',
    price: '800',
    priceNote: 'starting at — non-commercial',
    desc: 'Your show, every week. Build a real audience with a recurring slot.',
    features: ['Weekly broadcast slot', 'Streaming replay archive', 'Full analytics suite', 'Promotional support'],
  },
  {
    name: 'Hourly Sponsorship',
    price: '200',
    priceNote: '$200 – $500+ non-commercial · $1,000 commercial',
    desc: 'Sponsor an hour of programming. Your name on the air — 100% of the revenue goes to the artist.',
    features: ['Full hour sponsored by you', '100% goes to the artist', 'Streaming replay', 'Listener analytics'],
  },
];

const adshare = [
  {
    name: '30-Second Spots',
    price: '30',
    priceNote: '$30 – $50 non-commercial · $40 – $60+ commercial',
    desc: 'The classic radio spot. Short, punchy, and perfect for driving calls and clicks.',
    features: ['30 seconds of airtime', 'Non-commercial & commercial rates', 'Rotation across dayparts'],
  },
  {
    name: '60-Second Spots',
    price: '60',
    priceNote: '$60 – $120+ commercial',
    desc: 'A full minute to tell your story. More room to sell, more time to stick.',
    features: ['60 seconds of airtime', 'Commercial radio rates', 'Premium placement options'],
  },
  {
    name: 'Low Ad Load',
    price: '240',
    priceNote: '$240 – $480 per hour · 8 spots/hr',
    desc: 'Light rotation for brands that want presence without overwhelming the music.',
    features: ['8 spots per hour', '$240 – $480/hr', 'Mix of 30 & 60-sec spots'],
    popular: true,
  },
  {
    name: 'Medium Ad Load',
    price: '360',
    priceNote: '$360 – $720 per hour · 12 spots/hr',
    desc: 'The sweet spot. Strong rotation that keeps your brand top of mind all hour.',
    features: ['12 spots per hour', '$360 – $720/hr', 'Mix of 30 & 60-sec spots'],
  },
  {
    name: 'High Ad Load',
    price: '480',
    priceNote: '$480 – $960 per hour · 16 spots/hr',
    desc: 'Maximum impact. Own the hour with heavy rotation across every break.',
    features: ['16 spots per hour', '$480 – $960/hr', 'Mix of 30 & 60-sec spots'],
  },
];

const spins = [
  { name: '$1,000 Campaign', price: '1,000', spins: '33 spins', desc: '33 guaranteed spins at $30 per spin. A first run to test the waters and watch the reports roll in.' },
  { name: '$5,000 Campaign', price: '5,000', spins: '167 spins', desc: '167 guaranteed spins at $30 per spin. Serious rotation across both markets.' },
  { name: '$10,000 Campaign', price: '10,000', spins: '334 spins', desc: '334 guaranteed spins at $30 per spin. Heavy presence on Omaha and Kansas City airwaves.' },
  { name: '$20,000 Campaign', price: '20,000', spins: '667 spins', desc: '667 guaranteed spins at $30 per spin. Dominate both stations for a full campaign cycle.' },
  { name: '$30,000 Campaign', price: '30,000', spins: '1,000 spins', desc: '1,000 guaranteed spins at $30 per spin. A thousand spins. A thousand chances to be heard.', popular: true },
  { name: '$50,000 Campaign', price: '50,000', spins: '1,667 spins', desc: '1,667 guaranteed spins at $30 per spin. The flagship campaign — maximum market saturation.' },
];

const marketplaceItems = [
  {
    name: 'Song Sales',
    desc: 'Sell your singles direct to fans. No middleman, no waiting — your music, your price.',
    features: ['Set your own price', 'Instant fan delivery', 'You keep 70%'],
  },
  {
    name: 'Album Sales',
    desc: 'Full projects, EPs, and deluxe editions sold straight from your artist page.',
    features: ['Full album & EP sales', 'Deluxe bundles', 'You keep 70%'],
  },
  {
    name: 'Beat Sales',
    desc: 'Producers — lease or sell your beats to artists across the network.',
    features: ['Leases & exclusives', 'Built-in licensing', 'You keep 70%'],
  },
  {
    name: 'Merch Sales',
    desc: 'Shirts, hoodies, hats, posters — turn listeners into walking billboards.',
    features: ['Apparel & accessories', 'Print-on-demand options', 'You keep 70%'],
  },
];

const distribution = {
  name: 'Global Distribution',
  price: 199,
  priceNote: 'per year — we handle everything',
  desc: 'Your music on Spotify, Apple Music, TikTok, and 150+ platforms worldwide. We upload it, you keep 100% of your royalties.',
  features: [
    'Unlimited releases for 1 year',
    'Spotify, Apple Music, TikTok + 150 platforms',
    'You keep 100% of royalties',
    'Release-date scheduling',
    'ISRC + UPC codes included',
    'Pre-save smartlinks',
    'Playlist submission tools',
    'Done-for-you upload & metadata',
  ],
};
const memberships = [
  { name: 'Starter', price: 0, desc: 'Artist profile + 1 song submission. Free forever.', cta: 'Get Started' },
  { name: 'Creator', price: 29, desc: '3 song submissions + professional song review.', cta: 'Go Creator' },
  { name: 'Pro', price: 99, desc: 'Airplay + guaranteed review + analytics + 15% ad-share.', cta: 'Go Pro', popular: true },
  { name: 'Premium', price: 299, desc: 'Airplay + interview + 25% ad-share + analytics + global distribution.', cta: 'Go Premium' },
  { name: 'Elite', price: 999, desc: 'Airplay + interviews + 50% ad-share + featured artist + global distribution.', cta: 'Go Elite' },
];
---
<Layout title="Promote Your Music | Time Share Radio" description="Get your music reviewed, interviewed, and on the air. Song reviews, airplay campaigns, ad-share spots, spin packages, music & merch marketplace, distribution, memberships, and station rentals.">
  <section class="page-hero">
    <p class="eyebrow">For Artists</p>
    <h1>GET HEARD.<br /><em>GET PAID.</em></h1>
    <p class="hero-copy">Real reviews, real interviews, real airplay. Pick your move — every purchase directly supports independent radio.</p>
  </section>

  <!-- ONE-TIME PROMOTION PRODUCTS -->
  <section class="section">
    <div class="section-heading">
      <span class="section-num">01 / PROMOTION</span>
      <h2>AIRPLAY <em>PROMOTION</em></h2>
      <p>One-time purchases. Instant momentum.</p>
    </div>
    <div class="product-grid">
      {products.map(p => (
        <article class:list={['product-card', { popular: p.popular }]}>
          {p.popular && <span class="badge">Most Popular</span>}
          <h3>{p.name}</h3>
          <div class="price">
            <span class="amount">${p.price}</span>
            {p.priceNote && <span class="note">{p.priceNote}</span>}
          </div>
          <p class="desc">{p.desc}</p>
          <ul>
            {p.features.map(f => <li>{f}</li>)}
          </ul>
          <a class="button primary buy-btn" href="/contact/">
            Get {p.name} <b>→</b>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- AIRTIME RENTALS -->
  <section class="section alt">
    <div class="section-heading">
      <span class="section-num">02 / AIRTIME</span>
      <h2>RENT THE <em>AIRWAVES</em></h2>
      <p>Your show. Your audience. Your moment.</p>
    </div>
    <div class="product-grid">
      {airtime.map(a => (
        <article class="product-card">
          <h3>{a.name}</h3>
          <div class="price">
            <span class="amount">${a.price}</span>
            <span class="note">{a.priceNote}</span>
          </div>
          <p class="desc">{a.desc}</p>
          <ul>
            {a.features.map(f => <li>{f}</li>)}
          </ul>
          <a class="button primary buy-btn" href="/contact/" >
            Book Your Slot <b>→</b>
          </a>
        </article>
      ))}
    </div>
    <p class="fine-print">Commercial rates available. Contact us for custom packages and sponsorship opportunities.</p>
  </section>

  <!-- AD-SHARE -->
  <section class="section">
    <div class="section-heading">
      <span class="section-num">03 / AD-SHARE</span>
      <h2>ADVERTISE <em>WITH US</em></h2>
      <p>Radio spots for real businesses. Pick your length, pick your load, reach real listeners.</p>
    </div>
    <div class="product-grid">
      {adshare.map(a => (
        <article class:list={['product-card', { popular: a.popular }]}>
          {a.popular && <span class="badge">Most Popular</span>}
          <h3>{a.name}</h3>
          <div class="price">
            <span class="amount">${a.price}</span>
            <span class="note">{a.priceNote}</span>
          </div>
          <p class="desc">{a.desc}</p>
          <ul>
            {a.features.map(f => <li>{f}</li>)}
          </ul>
          <a class="button primary buy-btn" href="/contact/">
            Advertise With Us <b>→</b>
          </a>
        </article>
      ))}
    </div>
    <p class="fine-print">Revenue split: 25% artist · 50% station · 25% platform. Every ad supports independent artists and radio.</p>
  </section>

  <!-- AIRPLAY CAMPAIGNS -->
  <section class="section alt">
    <div class="section-heading">
      <span class="section-num">04 / AIRPLAY CAMPAIGNS</span>
      <h2>SPIN <em>PACKAGES</em></h2>
      <p>$30 per spin. Guaranteed spins, spin reports, and analytics — across two real markets.</p>
    </div>
    <div class="product-grid">
      {spins.map(s => (
        <article class:list={['product-card', { popular: s.popular }]}>
          {s.popular && <span class="badge">Best Value</span>}
          <h3>{s.name}</h3>
          <div class="price">
            <span class="amount">${s.price}</span>
            <span class="note">{s.spins} — $30 per spin</span>
          </div>
          <p class="desc">{s.desc}</p>
          <ul>
            <li>Guaranteed {s.spins.toLowerCase()}</li>
            <li>KOWN 95.7 The Boss — Omaha</li>
            <li>KPPZ 98.5 Urban Oldies — Kansas City</li>
            <li>Spin reports + analytics</li>
          </ul>
          <a class="button primary buy-btn" href="/contact/">
            Launch My Campaign <b>→</b>
          </a>
        </article>
      ))}
    </div>
    <p class="fine-print">Spins air on Omaha KOWN 95.7 The Boss and Kansas City KPPZ 98.5 Urban Oldies. Every campaign includes detailed spin reports and listener analytics.</p>
  </section>

  <!-- GLOBAL DISTRIBUTION -->
  <section class="section">
    <div class="section-heading">
      <span class="section-num">05 / DISTRIBUTION</span>
      <h2>GO <em>GLOBAL.</em></h2>
      <p>Your music on every platform on earth. We handle the upload — you keep every cent.</p>
    </div>
    <div class="pipeline">
      <div class="pipe-step"><span class="pipe-num">1</span><h4>We Distribute</h4><p>Your music lands on Spotify, Apple Music, TikTok &amp; 150+ platforms</p></div>
      <div class="pipe-arrow">→</div>
      <div class="pipe-step"><span class="pipe-num">2</span><h4>We Play It</h4><p>Your track spins on Time Share Radio and our station network</p></div>
      <div class="pipe-arrow">→</div>
      <div class="pipe-step"><span class="pipe-num">3</span><h4>You Get Paid</h4><p>Listeners stream it — you keep 100% of your royalties</p></div>
    </div>
    <div class="product-grid single">
      <article class="product-card popular">
        <span class="badge">New</span>
        <h3>{distribution.name}</h3>
        <div class="price">
          <span class="amount">${distribution.price}</span>
          <span class="note">{distribution.priceNote}</span>
        </div>
        <p class="desc">{distribution.desc}</p>
        <ul>
          {distribution.features.map(f => <li>{f}</li>)}
        </ul>
        <a class="button primary buy-btn" href="/contact/">
          Distribute My Music <b>→</b>
        </a>
      </article>
    </div>
    <p class="fine-print">Premium and Elite members get distribution included. Everyone else can add it anytime.</p>
  </section>

  <!-- MARKETPLACE -->
  <section class="section alt">
    <div class="section-heading">
      <span class="section-num">06 / MARKETPLACE</span>
      <h2>MUSIC &amp; <em>MERCH</em></h2>
      <p>Sell direct to your fans. Songs, albums, beats, and merch — you keep 70%.</p>
    </div>
    <div class="product-grid">
      {marketplaceItems.map(m => (
        <article class="product-card">
          <h3>{m.name}</h3>
          <p class="desc">{m.desc}</p>
          <ul>
            {m.features.map(f => <li>{f}</li>)}
          </ul>
          <a class="button primary buy-btn" href="/contact/">
            Start Selling <b>→</b>
          </a>
        </article>
      ))}
    </div>
    <p class="fine-print">Revenue split on every sale: 70% artist/label · 15% station · 15% platform.</p>
  </section>

  <!-- MEMBERSHIPS -->
  <section class="section">
    <div class="section-heading">
      <span class="section-num">07 / MEMBERSHIP</span>
      <h2>ARTIST <em>MEMBERSHIPS</em></h2>
      <p>Monthly plans that grow with your career. 75% goes to the station, 25% keeps the platform running.</p>
    </div>
    <div class="tier-grid">
      {memberships.map(m => (
        <article class:list={['tier-card', { popular: m.popular }]}>
          {m.popular && <span class="badge">Best Value</span>}
          <h3>{m.name}</h3>
          <div class="price">
            <span class="amount">{m.price === 0 ? 'Free' : `$${m.price}`}</span>
            {m.price > 0 && <span class="note">/month</span>}
          </div>
          <p class="desc">{m.desc}</p>
          <a class="button ghost buy-btn" href="/contact/">{m.cta} <b>→</b></a>
        </article>
      ))}
    </div>
    <p class="fine-print">Membership billing launching soon — join the waitlist and lock in founding rates.</p>
  </section>

  <!-- STATION SAAS -->
  <section class="section saas-band">
    <div class="saas-inner">
      <span class="section-num">08 / FOR STATIONS</span>
      <h2>RUN YOUR STATION<br />ON <em>TIME SHARE RADIO</em></h2>
      <p class="saas-copy">The full platform — artist directory, submissions, airplay management, analytics, and monetization — for your station. Not just a plugin. A complete system.</p>
      <div class="saas-price">
        <span class="amount">$99</span>
        <span class="note">/month per station</span>
      </div>
      <ul class="saas-features">
        <li>Artist directory + bio pages</li>
        <li>Music submission pipeline</li>
        <li>Airplay scheduling + analytics</li>
        <li>Built-in monetization (reviews, interviews, sponsorships)</li>
        <li>75/25 revenue split on all transactions</li>
      </ul>
      <a class="button primary" href="/contact/">Get Your Station On Board <b>→</b></a>
    </div>
  </section>
</Layout>
<style>
  .page-hero{text-align:center;padding:80px 24px 40px;max-width:800px;margin:0 auto}
  .eyebrow{text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:var(--orange);font-weight:700}
  .page-hero h1{font-size:clamp(48px,8vw,96px);line-height:.95;text-transform:uppercase;margin:20px 0}
  .page-hero h1 em{color:var(--orange);font-style:normal}
  .hero-copy{color:#888;font-size:18px;max-width:600px;margin:0 auto;line-height:1.6}
  .section{padding:60px 24px;max-width:1200px;margin:0 auto}
  .section.alt{background:#0d0d0d;border-top:1px solid #1a1a1a;border-bottom:1px solid #1a1a1a;max-width:100%}
  .section.alt .section-heading,.section.alt .fine-print{max-width:1200px;margin-left:auto;margin-right:auto}
  .section-heading{margin-bottom:40px}
  .section-num{font-size:11px;letter-spacing:.2em;color:var(--orange);text-transform:uppercase;font-weight:700}
  .section-heading h2{font-size:clamp(36px,5vw,56px);text-transform:uppercase;margin:12px 0 8px}
  .section-heading h2 em{color:var(--orange);font-style:normal}
  .section-heading p{color:#888;font-size:16px}
  .product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}
  .product-card{background:#141414;border:1px solid #222;border-radius:12px;padding:32px;position:relative;display:flex;flex-direction:column}
  .product-card.popular{border-color:var(--orange);box-shadow:0 0 40px rgba(255,107,0,.15)}
  .badge{position:absolute;top:-12px;left:24px;background:var(--orange);color:#000;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;padding:4px 12px;border-radius:20px}
  .product-card h3{font-size:22px;text-transform:uppercase;margin:0 0 12px}
  .price{margin-bottom:16px}
  .price .amount{font-size:40px;font-weight:800;color:var(--orange)}
  .price .note{display:block;font-size:12px;color:#666;margin-top:4px}
  .desc{color:#aaa;font-size:14px;line-height:1.6;margin:0 0 20px}
  .product-card ul{list-style:none;padding:0;margin:0 0 28px;flex:1}
  .product-card li{color:#888;font-size:13px;padding:6px 0;border-bottom:1px solid #1e1e1e}
  .product-card li:before{content:"✓ ";color:var(--orange);font-weight:700}
  .buy-btn{width:100%;text-align:center;justify-content:center}
  .tier-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px}
  .tier-card{background:#141414;border:1px solid #222;border-radius:12px;padding:28px;text-align:center;position:relative;display:flex;flex-direction:column}
  .tier-card.popular{border-color:var(--orange)}
  .tier-card h3{font-size:18px;text-transform:uppercase;margin:0 0 12px}
  .tier-card .price .amount{font-size:36px}
  .tier-card .desc{flex:1}
  .fine-print{text-align:center;color:#555;font-size:13px;margin-top:32px}
  .saas-band{background:linear-gradient(135deg,#1a0d00,#0a0a0a);border:1px solid #ff6b0033;border-radius:16px;margin:0 24px 80px;max-width:1152px;text-align:center}
  .saas-inner{padding:70px 40px}
  .saas-band h2{font-size:clamp(36px,5vw,60px);text-transform:uppercase;margin:16px 0}
  .saas-band h2 em{color:var(--orange);font-style:normal}
  .saas-copy{color:#aaa;font-size:17px;max-width:640px;margin:0 auto 32px;line-height:1.7}
  .saas-price{margin-bottom:28px}
  .saas-price .amount{font-size:72px;font-weight:800;color:var(--orange)}
  .saas-price .note{color:#888;font-size:16px}
  .saas-features{list-style:none;padding:0;margin:0 auto 36px;max-width:480px;text-align:left}
  .saas-features li{color:#ccc;font-size:15px;padding:10px 0;border-bottom:1px solid #222}
  .saas-features li:before{content:"✓ ";color:var(--orange);font-weight:700}
  .pipeline{display:flex;align-items:center;justify-content:center;gap:16px;max-width:900px;margin:0 auto 48px;flex-wrap:wrap}
  .pipe-step{background:#1a1a1a;border:1px solid #2a2a2a;border-radius:12px;padding:24px;flex:1;min-width:200px;text-align:center}
  .pipe-num{display:inline-block;background:var(--orange);color:#000;font-weight:800;width:32px;height:32px;line-height:32px;border-radius:50%;margin-bottom:12px}
  .pipe-step h4{margin:0 0 8px;font-size:16px;text-transform:uppercase}
  .pipe-step p{margin:0;color:#888;font-size:13px;line-height:1.5}
  .pipe-arrow{color:var(--orange);font-size:28px;font-weight:800}
  .product-grid.single{max-width:520px;margin:0 auto}
  @media(max-width:768px){
    .saas-band{margin:0 16px 60px}
    .saas-inner{padding:50px 24px}
    .pipe-arrow{display:none}
    .pipeline{flex-direction:column}
  }
</style>
