---
import Layout from '../layouts/Layout.astro';
const products = [
  { name: 'A Kay A — Everything Irie', artist: 'A KAY A', price: '$1.99', image: '/images/products/everything-irie.png', href: 'https://957fmtheboss.com/product/a-kay-a-everything-irie/' },
];
---
<Layout title="Music Shop Demo | Time Share Radio" description="See the music storefront created by the Time Share Radio WordPress plugin.">
  <section class="shop-head"><span class="section-num">PLUGIN DEMO / MUSIC SHOP</span><h1>FROM PROFILE<br /><em>TO PURCHASE.</em></h1><p>The plugin connects artist profiles to a clean, searchable music storefront powered by WooCommerce.</p></section>
  <section class="demo-bar"><span>LIVE FEATURE PREVIEW</span><p>This page demonstrates the shop experience generated by the plugin.</p><a href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG">Buy the plugin ↗</a></section>
  <section class="plugin-shop"><div class="shop-tools"><strong>Shop</strong><span id="shop-count">Showing 1 result</span><button>Default sorting⌄</button></div><div class="plugin-product-grid" id="shop-grid">
    {products.map((product, i) => <article class="plugin-product"><a class="product-link" href={product.href} target="_blank" rel="noopener noreferrer"><div class={`cover cover-${i + 1}`} style={`background-image:url(${product.image})`}><span></span><i>0{i + 1}</i></div><small>{product.artist}</small><h2>{product.name}</h2><strong>{product.price}</strong><span class="add-cart">View product ↗</span></a></article>)}
  </div></section>
  <script>
    const savedRelease = localStorage.getItem('timeshare-radio-shop-song');
    const shopGrid = document.querySelector<HTMLElement>('#shop-grid');
    function loadAudio() {
      return new Promise<Blob | null>((resolve) => {
        const request = indexedDB.open('timeshare-radio', 1);
        request.addEventListener('upgradeneeded', () => request.result.createObjectStore('uploads'));
        request.addEventListener('error', () => resolve(null));
        request.addEventListener('success', () => {
          const audioRequest = request.result.transaction('uploads').objectStore('uploads').get('shop-song');
          audioRequest.addEventListener('success', () => { request.result.close(); resolve(audioRequest.result || null); });
          audioRequest.addEventListener('error', () => resolve(null));
        });
      });
    }
    if (savedRelease && shopGrid) {
      try {
        const release = JSON.parse(savedRelease);
        const product = document.createElement('article');
        product.className = 'plugin-product local-shop-product';
        const cover = document.createElement('div');
        cover.className = 'cover cover-2';
        if (release.coverData) cover.style.backgroundImage = `url(${release.coverData})`;
        const number = document.createElement('i'); number.textContent = '02'; cover.append(number);
        const artist = document.createElement('small'); artist.textContent = release.artist;
        const title = document.createElement('h2'); title.textContent = release.title;
        const genre = document.createElement('p'); genre.className = 'release-genre'; genre.textContent = release.genre || 'Independent release';
        const price = document.createElement('strong'); price.textContent = release.price ? `$${String(release.price).replace(/^\$/, '')}` : 'Coming soon';
        const audio = document.createElement('audio'); audio.controls = true; audio.preload = 'metadata';
        loadAudio().then((blob) => { if (blob) audio.src = URL.createObjectURL(blob); });
        product.append(cover, artist, title, genre, price, audio);
        shopGrid.append(product);
        const count = document.querySelector('#shop-count'); if (count) count.textContent = 'Showing 2 results';
      } catch { localStorage.removeItem('timeshare-radio-shop-song'); }
    }
  </script>
</Layout>
