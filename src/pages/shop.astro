---
import Layout from '../layouts/Layout.astro';
const products = [
  { name: 'A Kay A — Everything Irie', artist: 'A KAY A', price: '$1.99', image: '/images/products/everything-irie.png', href: 'https://957fmtheboss.com/product/a-kay-a-everything-irie/' },
  { name: 'Featured Release 2', artist: 'TIME SHARE RADIO', price: '$19.99' },
  { name: 'Featured Release 3', artist: 'TIME SHARE RADIO', price: '$19.99' },
  { name: 'Featured Release 4', artist: 'TIME SHARE RADIO', price: '$19.99' },
];
---
<Layout title="Music Shop Demo | Time Share Radio" description="See the music storefront created by the Time Share Radio WordPress plugin.">
  <section class="shop-head"><span class="section-num">PLUGIN DEMO / MUSIC SHOP</span><h1>FROM PROFILE<br /><em>TO PURCHASE.</em></h1><p>The plugin connects artist profiles to a clean, searchable music storefront powered by WooCommerce.</p></section>
  <section class="demo-bar"><span>LIVE FEATURE PREVIEW</span><p>This page demonstrates the shop experience generated by the plugin.</p><a href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG">Buy the plugin ↗</a></section>
  <section class="plugin-shop"><div class="shop-tools"><strong>Shop</strong><span>Showing all 4 results</span><button>Default sorting⌄</button></div><div class="plugin-product-grid">
    {products.map((product, i) => <article class="plugin-product"><a class="product-link" href={product.href || '#'}><div class={`cover cover-${i + 1}`} style={product.image ? `background-image:url(${product.image})` : undefined}><span>{product.image ? '' : 'TSR'}</span><i>0{i + 1}</i></div><small>{product.artist}</small><h2>{product.name}</h2><strong>{product.price}</strong><span class="add-cart">{i === 0 ? 'View product' : 'Add to cart'} ↗</span></a></article>)}
  </div></section>
</Layout>
