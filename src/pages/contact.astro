---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Time Share Radio" description="Get in touch with Time Share Radio.">
  <section class="page-hero">
    <p class="eyebrow"><span></span>Contact</p>
    <h1>Let's <em>talk.</em></h1>
    <p>Questions about the platform, artist submissions, station partnerships, or anything else — drop us a line.</p>
  </section>
  <section class="contact-section">
    <form id="contact-form" class="bio-form" novalidate>
      <div class="field-row">
        <label>Name<input type="text" name="name" required autocomplete="name" maxlength="100" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" maxlength="254" /></label>
      </div>
      <label>Subject
        <select name="subject" required>
          <option value="">Please choose</option>
          <option>General question</option>
          <option>Artist submission</option>
          <option>Station partnership</option>
          <option>Support</option>
          <option>Other</option>
        </select>
      </label>
      <label>Message<textarea name="goal" rows="6" required maxlength="2000" placeholder="Tell us what's on your mind..."></textarea></label>
      <div class="form-actions">
        <button type="submit" class="button primary">Send message <b>→</b></button>
      </div>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>
<style>
  .contact-section{padding:60px clamp(22px,7vw,110px) 120px;max-width:800px}
  .bio-form select{width:100%;border:1px solid var(--line);border-radius:0;background:#fff;padding:16px 17px;color:var(--ink);font:400 15px/1.5 Manrope;outline:none}
  .bio-form select:focus{border-color:var(--orange);box-shadow:0 0 0 1px var(--orange)}
  .bio-form label{display:flex;flex-direction:column;gap:10px;text-transform:uppercase;font:600 10px DM Mono;letter-spacing:.08em;margin-bottom:24px}
</style>
<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Sending...';
    const data = new FormData(form);
    try {
      const res = await fetch('https://elevated-forms-production.icy-flower-c65e.workers.dev', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          siteId: 'timeshareradio',
          formId: 'contact',
          name: data.get('name'),
          email: data.get('email'),
          goal: `Subject: ${data.get('subject')}\n\n${data.get('goal')}`,
        }),
      });
      if (res.ok) {
        status.textContent = 'Thanks — we received your message and will follow up shortly.';
        form.reset();
      } else {
        status.textContent = 'Sorry, something went wrong. Please try again.';
      }
    } catch {
      status.textContent = 'Sorry, something went wrong. Please try again.';
    }
  });
</script>
