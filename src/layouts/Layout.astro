---
import ElevatedSecurityBadge from '../components/ElevatedSecurityBadge.astro';

import '../styles/global.css';
const { title = 'Time Share Radio', description = 'A new stage for independent artists.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GBSFKT12E0"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GBSFKT12E0');
  </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f24822" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Time Share Radio home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>TIME SHARE<small>RADIO</small></span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" aria-label="Main navigation">
        <a href="/">Home</a><a href="/artist/">Artists</a><a href="/promote/">Promote</a><a href="/shop/">Shop</a><a href="/stations/">Stations</a><a href="/about/">About</a><a href="/contact/">Contact</a>
        <a class="nav-cta" href="https://www.paypal.com/ncp/payment/2DSWELQCG67ZG">Buy now</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <a class="brand footer-brand" href="/"><span class="brand-mark"><i></i><i></i><i></i><i></i></span><span>TIME SHARE<small>RADIO</small></span></a>
      <div class="footer-content">
        <p>The artist and music-store plugin for WordPress.</p>
        <a class="footer-portal" href="/portal/">
          <span>For artists</span>
          Artist Portal <b>↗</b>
        </a>
      </div>
      <a class="footer-boss" href="https://957fmtheboss.com/" target="_blank" rel="noopener">
          <span>Now streaming</span>
          95.7 The Boss <b>↗</b>
        </a>
      <p class="copyright">© {new Date().getFullYear()} Time Share Radio</p>
    <style>
  .footer-boss{display:inline-flex;align-items:center;gap:18px;background:var(--orange);color:#fff;padding:15px 18px;text-decoration:none;text-transform:uppercase;font:600 11px DM Mono;margin-top:20px}
  .footer-boss span{color:rgba(255,255,255,.7);font-size:8px}
  .footer-boss b{font-size:15px}
</style>
<ElevatedSecurityBadge />
</footer>
    <script>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>
